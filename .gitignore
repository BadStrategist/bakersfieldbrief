# Bakersfield Daily Brief — build artifacts, secrets, junk
.venv/
__pycache__/
*.pyc
.DS_Store
*.log

# Local-only secrets / keys (never commit)
.env
*.key

# Local source cache (regenerated by every CI run)
data/source_cache.json

# Built static output (CI builds it fresh and deploys the artifact)
site/

# Editor
.idea/
.vscode/

# Kern Overnight pipeline artifacts — audio stays local (GBs), but
# transcripts are small (~180KB/day) and ARE committed: they are the
# cloud-side recovery source if the PC dies mid-night.
/audio/
/briefs/
kern_overnight/.bcfy_cookie.json

# Local scratch that is neither source nor deployable output. The CI artifact
# commit stages `data` (and, on its retry path, `git add -A`), so an unignored
# dump here can be swept into a deploy commit.
/work/
/transcripts/*.lock
/Y812BT*
.wrangler/

# Claude Code local settings (per-machine, not source)
.claude/

# Reel render + probe output (regenerated on demand)
scripts/brief_reel/out/
